# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only this email can become the owner (passkey or GitHub sign-in).
OWNER_EMAIL=you@example.com

# ---- Database ----
# App role: read/write on tables only, no schema changes.
DATABASE_URL=postgres://ctcd_app:ctcd_app@localhost:5433/ctcd
# Migration role: owns the schema. Used by drizzle-kit (npm run db:migrate locally, CI before deploy).
MIGRATION_DATABASE_URL=postgres://ctcd:ctcd@localhost:5433/ctcd

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (Resend). Leave RESEND_API_KEY empty locally: mail is printed to the log. ----
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Coder thích chơi đàn <hello@mail.coderthichchoidan.dev>"

# ---- Background jobs (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Rate limit and view counters (Upstash Redis). Empty = in-memory fallback for dev. ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Storage (Cloudflare R2, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=ctcd-public
R2_PRIVATE_BUCKET=ctcd-private
R2_PUBLIC_HOST=

# ---- Spam protection (Cloudflare Turnstile). Empty = skipped in dev. ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Monitoring (Sentry). Empty = off. ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
